# ---------------------------------------------------------------
# Google Calendar (solo servidor — nunca se envía al navegador)
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Zona horaria usada para calcular el día consultado
TZ=Europe/Madrid

# ---------------------------------------------------------------
# Base de datos (Supabase propio o self-hosted) — persistencia de
# la configuración y de las colecciones de la app.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
